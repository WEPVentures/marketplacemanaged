# Copy to .env for local dev (Eleventy doesn't auto-load .env; use `node --env-file=.env` or export them).

# Used ONLY at build time to read active items. Never reaches the browser.
# The anon/publishable key is enough: RLS exposes only status='active' rows of `items`.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Facebook Page username -> https://m.me/<PAGE_NAME>?ref=site-start (the "Start" button) and ?ref=<item-id> (item pages).
# If the Page handle changes, update this in Netlify and redeploy.
PAGE_NAME=MarketplaceManaged

# Canonical origin (used in canonical/og/JSON-LD URLs). Netlify's URL is the fallback.
SITE_URL=https://marketplacemanaged.com

# Netlify only: stops the secret scanner flagging the public values above.
SECRETS_SCAN_OMIT_KEYS=SUPABASE_URL,SUPABASE_ANON_KEY,SITE_URL,PAGE_NAME

# The Netlify build hook URL is NOT an env var here: it lives in the Supabase table private.config
# (see supabase/migrations/0002_build_hook.sql), because the database is what calls it.
