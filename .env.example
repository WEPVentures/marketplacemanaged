# Copy to .env for local dev (Eleventy doesn't auto-load .env; use `node --env-file=.env` or export them).
# Public values — safe to ship to the browser. RLS is what protects the data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Facebook Page username -> https://m.me/<PAGE_NAME>?ref=intake-0042
PAGE_NAME=MarketplaceManaged

# Canonical origin (used in canonical/og/JSON-LD URLs). Netlify's URL is the fallback.
SITE_URL=https://marketplacemanaged.com
