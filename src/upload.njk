---
layout: layouts/base.njk
title: List your item
description: Upload photos and details, then continue in Messenger for your price range.
permalink: /upload/
---
<section class="section">
  <div class="wrap narrow">
    <div id="form-view">
      <h1>List your item</h1>
      <p class="lede">Takes about two minutes. Next you'll continue in Messenger for your price range.</p>
      {% if not site.supabaseUrl %}<p class="notice">Dev mode: SUPABASE_URL / SUPABASE_ANON_KEY aren't set, so submit will simulate an upload.</p>{% endif %}
      <form id="intake" novalidate>
        <div class="field">
          <label for="photos">Photos <span class="req">*</span></label>
          <p class="hint">Up to 8. The first photo is the hero — tap "Make hero" to change it.</p>
          <input id="photos" type="file" accept="image/*" multiple>
          <ul id="previews" class="previews"></ul>
        </div>
        <div class="field"><label for="title">Item title <span class="req">*</span></label><input id="title" name="title" maxlength="120" required placeholder="e.g. DeWalt 20V cordless drill"></div>
        <div class="field"><label for="description">Description <span class="req">*</span></label><textarea id="description" name="description" rows="4" maxlength="2000" required></textarea></div>
        <div class="field"><label for="condition">Condition <span class="req">*</span></label>
          <select id="condition" name="condition" required><option value="">Select…</option><option>Like new</option><option>Good</option><option>Fair</option><option>For parts</option></select></div>
        <div class="field"><label for="model_number">Model number <span class="opt">(optional)</span></label><input id="model_number" name="model_number" maxlength="80"></div>
        <fieldset class="field"><legend>Does it work? <span class="req">*</span></legend>
          <label class="radio"><input type="radio" name="works" value="yes" required> Yes</label>
          <label class="radio"><input type="radio" name="works" value="partially"> Partially</label>
          <label class="radio"><input type="radio" name="works" value="no"> No</label></fieldset>
        <div class="field"><label for="damage">Damage notes</label><textarea id="damage" name="damage" rows="2" maxlength="1000" placeholder="Scratches, dents, missing parts… or “none”"></textarea></div>
        <div class="field"><label for="included">What's included</label><textarea id="included" name="included" rows="2" maxlength="1000" placeholder="Charger, box, manual…"></textarea></div>
        <div class="field"><label for="customer_name">Your name <span class="req">*</span></label><input id="customer_name" name="customer_name" maxlength="80" required autocomplete="name"></div>
        <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true">
        <p id="error" class="error" role="alert" hidden></p>
        <button id="submit" class="btn btn-lg btn-block" type="submit">Upload item</button>
        <p class="fine center">No payment on this page — the $5 is collected in Messenger.</p>
      </form>
    </div>

    <div id="done-view" hidden class="center done">
      <h1>Upload received</h1>
      <p class="lede">Your reference is <strong id="ref"></strong>. Continue in Messenger and we'll send your price range.</p>
      <a id="messenger" class="btn btn-msgr btn-lg btn-block" href="#">Continue in Messenger</a>
    </div>
  </div>
</section>
<script id="cfg" type="application/json">{{ { supabaseUrl: site.supabaseUrl, anonKey: site.supabaseAnonKey, pageName: site.pageName } | json | safe }}</script>
<script src="{{ '/assets/js/upload.js' | assetVersion }}" defer></script>
